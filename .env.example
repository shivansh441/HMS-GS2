# =============================================================================
# GrandStay Hybrid Hostel & Hotel Enterprise Management System
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and replace placeholder values with your environment configuration.
# Never commit real credentials or production secrets to source control.

# -----------------------------------------------------------------------------
# 1. RUNTIME & APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# Target execution environment: development | staging | production | test
NODE_ENV=development
ENVIRONMENT=development

# Enable or disable debug mode (MUST be false in production)
DEBUG=false

# Application metadata and branding
PROJECT_NAME="GrandStay Hybrid Hostel-Cum-Hotel Management System"
VITE_APP_NAME="GrandStay Hybrid HMS"

# -----------------------------------------------------------------------------
# 2. SERVER & NETWORKING
# -----------------------------------------------------------------------------
# Host and port on which the Express / Vite server binds
HOST=0.0.0.0
PORT=3000

# Base prefix for REST API endpoints
API_V1_STR=/api/v1
VITE_API_BASE_URL=/api/v1

# Cross-Origin Resource Sharing (CORS) - Comma-separated or JSON array of trusted origins
# In production, specify explicit domain(s) e.g., ["https://app.grandstay.com"]
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (POSTGRESQL 16)
# -----------------------------------------------------------------------------
# PostgreSQL connection parameters
POSTGRES_USER=grandstay_admin
POSTGRES_PASSWORD=replace_with_strong_password_minimum_16_chars
POSTGRES_DB=grandstay_hms
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# Database connection URL (standard PostgreSQL URI format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://grandstay_admin:replace_with_strong_password@localhost:5432/grandstay_hms

# Database connection pool settings (for high-concurrency production deployments)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC SECURITY & JWT TOKENS
# -----------------------------------------------------------------------------
# Cryptographic secret key used for HMAC-SHA256 JWT signing
# Generate a cryptographically secure 256-bit random key: openssl rand -hex 32
SECRET_KEY=replace_with_cryptographically_secure_random_hex_32_chars_minimum

# Token expiration lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# -----------------------------------------------------------------------------
# 5. INITIAL PLATFORM ADMINISTRATOR (BOOTSTRAP ONLY)
# -----------------------------------------------------------------------------
# Used exclusively by scripts/bootstrap_admin.ts during first-time deployment.
# Not stored in application runtime memory.
ADMIN_EMAIL=admin@grandstay.com
ADMIN_PASSWORD=replace_with_admin_password_min_12_chars
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Administrator

# -----------------------------------------------------------------------------
# 6. LOGGING & OBSERVABILITY
# -----------------------------------------------------------------------------
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log output format: console | json (use json in containerized production)
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# 7. OPTIONAL INTEGRATIONS
# -----------------------------------------------------------------------------
# AI Assistant / Analytics enhancements (server-side only)
GEMINI_API_KEY=
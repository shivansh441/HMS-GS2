# ==========================================
# HAVEN STAYS MONOREPO ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# BACKEND (FastAPI - Port 8000)
# ------------------------------------------
# Database connection: Falls back to SQLite (sqlite:///./haven_stays.db) when unset.
# For PostgreSQL: postgresql://haven_admin:HavenPostgresPassword123!@localhost:5432/haven_stays
DATABASE_URL="sqlite:///./haven_stays.db"

# JWT Secret for signing access tokens (aud: admin | customer)
JWT_SECRET="haven_stays_jwt_secret_must_be_at_least_32_bytes_long_random_key_12345"

# AES-256-GCM 32-byte key (Base64 URL-safe) for sensitive PII encryption (e.g. ID numbers, MFA secrets)
ENCRYPTION_KEY_B64="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="

# Explicit CORS allow-list for admin panel (:5173) and public website (:3000)
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]'

ENVIRONMENT="development"
DEBUG="true"

# ------------------------------------------
# ADMIN PANEL (React + Vite - Port 5173)
# ------------------------------------------
VITE_API_URL="http://localhost:8000/api/v1"

# ------------------------------------------
# PUBLIC WEBSITE (Next.js - Port 3000)
# ------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# ------------------------------------------
# AI STUDIO RUNTIME VARS
# ------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

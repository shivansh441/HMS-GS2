# ==============================================================================
# HOSTEL-CUM-HOTEL MANAGEMENT SYSTEM - CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# Generate a secure 64-character secret key via: openssl rand -hex 32

ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Hostel-Cum-Hotel Management System"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hostel_admin
POSTGRES_PASSWORD=hostel_admin_secure_password_placeholder
POSTGRES_DB=hostel_management
DATABASE_URL=postgresql+psycopg://hostel_admin:hostel_admin_secure_password_placeholder@localhost:5432/hostel_management

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Security Baseline & JWT Authentication
# Replace with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_cryptographically_secure_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Server Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend Client Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Hostel & Hotel Manager"
VITE_ENABLE_MOCK_FALLBACK=false

# AI Studio Platform Variables (Injected at runtime by platform)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
